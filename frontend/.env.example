# Frontend environment variables
# Copy this file to .env.local and customize as needed.

# Support link shown in the header (defaults to GitHub Issues)
# VITE_SUPPORT_URL=https://github.com/ui-insight/vandalizer/issues

# ============================================================================
# Institution-specific settings
# ============================================================================

# Name of the deploying institution. Shown on certification credentials.
# Defaults to "University of Idaho" if not set.
# VITE_INSTITUTION_NAME=University of Idaho

# Name of the certification credential. Shown on certification credentials
# and in the certification module UI.
# Defaults to "Vandal Workflow Architect" if not set.
# VITE_CERTIFICATION_NAME=Vandal Workflow Architect
